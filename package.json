{
  "name": "spanstories",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project spanstories-test \"node --test tests/firestore.rules.test.mjs\"",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"features/**/*.test.ts\"",
    "curriculum:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/curriculum/import-a1.ts",
    "curriculum:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/curriculum/import-a1.ts --check",
    "db:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/migrate-and-seed.ts",
    "db:test:server": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test features/persistence/__tests__/server-parity.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "firebase": "^12.19.0",
    "next": "16.2.11",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.2.11",
    "typescript": "latest"
  }
}
